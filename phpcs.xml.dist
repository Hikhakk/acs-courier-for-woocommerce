<?xml version="1.0"?>
<ruleset name="ACS Courier for WooCommerce">
    <description>
        WordPress coding standards for a directory-hosted plugin.

        Security, correctness and compatibility sniffs are enforced strictly.
        Two families are relaxed, deliberately and narrowly, for src/ only —
        see the documented exclusions below.
    </description>

    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/stubs/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg value="ps"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress-Extra">
        <!-- PSR-4 autoloading requires StudlyCase class filenames. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress-Docs"/>

    <!--
        Naming: WPCS's snake_case rules date from procedural WordPress. This
        plugin's src/ is namespaced PSR-4 OOP, the same style WooCommerce uses
        in its own src/ directory. Renaming $recipientName to $recipient_name
        would make the code inconsistent with the ecosystem it plugs into.
        Enforced everywhere except src/.
    -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>

    <!--
        False positive: this sniff fires on `throw new X($e->getMessage())`,
        treating a rethrow as output. Nothing in src/ echoes. Any code that
        does echo lives in src/Admin and src/Frontend, where the sniff stays on.
    -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>src/Api/*</exclude-pattern>
        <exclude-pattern>src/Service/*</exclude-pattern>
    </rule>

    <!-- Global prefixes for anything procedural. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="acs_wc"/>
                <element value="AcsCourier"/>
            </property>
        </properties>
    </rule>

    <!-- Hard floors. -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.0-"/>
    <config name="minimum_wp_version" value="6.0"/>
</ruleset>
